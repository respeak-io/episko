  "runs": [
    {
      "invocations": [{ "executionSuccessful": true, "toolExecutionNotifications": [] }],
      "results": [
        {
          "fingerprints": { "matchBasedId/v1": "4c1f9e" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "app/views.py", "uriBaseId": "%SRCROOT%" },
            "region": { "startLine": 17, "startColumn": 5, "endLine": 17, "endColumn": 40, "snippet": { "text": "cursor.execute(q)" } } } }],
          "message": { "text": "Detected user input used to manually construct a SQL string.\nUse parameterized queries instead." },
          "properties": {},
          "ruleId": "python.django.security.injection.tainted-sql-string.tainted-sql-string"
        },
        {
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "app/debug.py", "uriBaseId": "%SRCROOT%" }, "region": { "startLine": 4 } } }],
          "message": { "text": "Debug mode is enabled." },
          "ruleId": "python.flask.security.audit.debug-enabled.debug-enabled"
        },
        {
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "app/legacy.py", "uriBaseId": "%SRCROOT%" }, "region": { "startLine": 9 } } }],
          "message": { "text": "Detected user input used to manually construct a SQL string." },
          "ruleId": "python.django.security.injection.tainted-sql-string.tainted-sql-string",
          "suppressions": [{ "kind": "inSource" }]
