      ],
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.95.0",
          "rules": [
            {
              "id": "python.django.security.injection.tainted-sql-string.tainted-sql-string",
              "name": "python.django.security.injection.tainted-sql-string.tainted-sql-string",
              "defaultConfiguration": { "level": "error" },
              "shortDescription": { "text": "Semgrep Finding: python.django.security.injection.tainted-sql-string.tainted-sql-string" },
              "helpUri": "https://semgrep.dev/r/python.django.security.injection.tainted-sql-string.tainted-sql-string",
              "properties": { "precision": "very-high", "tags": ["CWE-89: SQL Injection", "OWASP-A03:2021 - Injection", "security"] }
