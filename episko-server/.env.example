# episko-server configuration. Copy to .env (untracked) and uncomment what you change:
#   cp .env.example .env
# Every variable is optional, and its default is what the server does without it.
# ./update.sh lists the variables a release adds here.

# Let people pair with this code and their own name, without an invite each.
# At least 12 characters: anyone holding it can join. Unset, pairing is invite-only.
# EPISKO_REGISTER_CODE=

# Days a superseded event is kept. The latest value per key always stays.
# EPISKO_RETENTION_DAYS=30

# The database file and the listen address. The Docker image sets both
# (/data/episko.db, 0.0.0.0:7878); change them only for a binary run outside Docker.
# EPISKO_DB=episko.db
# EPISKO_BIND=127.0.0.1:7878
